# Copy to .env and fill in the key for ONE provider. .env is git-ignored.
# Run `python llm_file_assistant.py --list-providers` to see what is configured.

# Force a provider (otherwise auto-detected in this order: anthropic, openai, gemini,
# openrouter, ollama -- the first one that has a key / base URL set).
# LLM_PROVIDER=anthropic          # anthropic | openai | gemini | openrouter | ollama

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5          # default; claude-sonnet-5-5 is cheaper

# --- OpenAI ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini                 # default
# OPENAI_BASE_URL=                         # optional: Azure/proxy/any OpenAI-compatible server

# --- Google Gemini (OpenAI-compatible endpoint; key from https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=                            # GOOGLE_API_KEY is also accepted
# GEMINI_MODEL=gemini-3.8-flash            # default

# --- OpenRouter (one key, hundreds of models; key from https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini      # default; names are 'vendor/model', pick one that supports tools
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Ollama (local models, NO key needed: use --provider ollama or LLM_PROVIDER=ollama) ---
# OLLAMA_MODEL=qwen3:8b                    # default; must support tool calling and be pulled first
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=                          # only for Ollama cloud

# Sandbox root the file tools may touch (default: this project folder).
# FS_ROOT=
